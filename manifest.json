{
  "manifest_version": 3,
  "name": "TCGplayer Order History → Google Sheets",
  "version": "1.0.0",
  "description": "1-click sync of TCGplayer Order History to Google Sheets.",
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://*.tcgplayer.com/*",
    "https://sheets.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "132832760796-u1odnj7gphj975b16tj9hl4hh44ocgjl.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tcgplayer.com/*order*",
        "https://*.tcgplayer.com/*myaccount*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}